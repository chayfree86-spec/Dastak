APP_NAME=Dastak
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.dastakdelivery.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dastak_db
DB_USERNAME=root
DB_PASSWORD=

# Live production DB (api.dastak.cc) — only for dastak:push-to-live / pull-from-live
DB_LIVE_HOST=
DB_LIVE_PORT=3306
DB_LIVE_DATABASE=
DB_LIVE_USERNAME=
DB_LIVE_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=dastak_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@dastakdelivery.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment Gateway (Abstracted)
PAYMENT_GATEWAY_DEFAULT=razorpay
RAZORPAY_KEY=
RAZORPAY_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# Platform Settings
DASTAK_ORDER_CANCEL_WINDOW_MINUTES=5
DASTAK_DEFAULT_COMMISSION_PERCENTAGE=15
DASTAK_BASE_DELIVERY_FEE=35.00
DASTAK_MAX_DELIVERY_RADIUS_KM=12
